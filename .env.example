DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true&schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# TARGET_DATABASE_URL is only needed when importing into the future production database.
# TARGET_DATABASE_URL="postgresql://USER:PASSWORD@PROD-HOST:5432/DATABASE?schema=public"

# Supabase Storage (server-only; never expose the service-role key to the browser)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="school-submissions"

# Admin dashboard
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
